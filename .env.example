# ── Email backend ────────────────────────────────────────────────────────────
# Options: smtp | resend
EMAIL_BACKEND=smtp

# Recipient and sender addresses
EMAIL_TO=you@example.com
EMAIL_FROM=alerts@example.com

# ── SMTP (required when EMAIL_BACKEND=smtp) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password

# ── App config ───────────────────────────────────────────────────────────────
# Path to sources config (default: config/sources.yaml)
SOURCES_CONFIG=config/sources.yaml

# SQLite database path (default: sports_jobs.db)
DB_PATH=sports_jobs.db

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: text (human-readable) | json (structured, use in GHA)
LOG_FORMAT=text
